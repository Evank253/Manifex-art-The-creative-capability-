{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MANIFEX CCI Benchmark Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id",
    "benchmark_name",
    "outcome"
  ],
  "properties": {
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_name": {
      "type": "string",
      "minLength": 1
    },
    "test_case": {
      "type": "string"
    },
    "hardware": {
      "type": "string",
      "default": "NOT_MEASURED"
    },
    "software_versions": {
      "type": "string"
    },
    "duration_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "quality_metrics": {
      "type": "object"
    },
    "outcome": {
      "enum": [
        "NOT_MEASURED",
        "PASS",
        "FAIL",
        "INCONCLUSIVE"
      ]
    },
    "artifact_uri": {
      "type": "string"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^([a-fA-F0-9]{64})?$"
    },
    "run_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  }
}
