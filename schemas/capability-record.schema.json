{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manifex.example/schemas/capability-record.schema.json",
  "title": "MANIFEX Capability Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "name",
    "category",
    "description",
    "status",
    "provenance",
    "rights",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{2,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interfaces": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protocols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "hardware": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operating_systems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "network_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "estimated_cost": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "required": [
        "discovery",
        "implementation",
        "testing",
        "measurement",
        "integration"
      ],
      "properties": {
        "discovery": {
          "enum": [
            "UNREVIEWED",
            "INVENTORIED",
            "DUPLICATE_CANDIDATE"
          ]
        },
        "implementation": {
          "enum": [
            "NOT_STARTED",
            "PROTOTYPE",
            "IMPLEMENTED"
          ]
        },
        "testing": {
          "enum": [
            "NOT_TESTED",
            "PASS",
            "FAIL",
            "PARTIAL"
          ]
        },
        "measurement": {
          "enum": [
            "NOT_MEASURED",
            "MEASURED",
            "UNRESOLVED"
          ]
        },
        "integration": {
          "enum": [
            "NOT_INTEGRATED",
            "INTEGRATION_REQUIRED",
            "INTEGRATED"
          ]
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_type"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "repository",
            "file",
            "model",
            "service",
            "paper",
            "manual_test",
            "other"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "content_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "rights": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNKNOWN",
            "REVIEW_REQUIRED",
            "CLEARED",
            "RESTRICTED"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "terms_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "attribution_required": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "commercial_use": {
          "enum": [
            "YES",
            "NO",
            "CONDITIONAL",
            "UNKNOWN"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test_id",
          "status"
        ],
        "properties": {
          "test_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "NOT_TESTED",
              "PASS",
              "FAIL",
              "PARTIAL",
              "NOT_MEASURED",
              "UNRESOLVED"
            ]
          },
          "run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "artifact_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "kind",
          "status"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "claim",
              "artifact",
              "runtime_log",
              "reproduction",
              "independent_review",
              "benchmark",
              "license_review",
              "other"
            ]
          },
          "status": {
            "enum": [
              "UNVERIFIED",
              "VERIFIED",
              "DISPUTED",
              "NOT_MEASURED",
              "UNRESOLVED"
            ]
          },
          "uri": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([a-fA-F0-9]{64})?$"
          },
          "captured_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
